{
  "name": "reacttypingspeedtest",
  "version": "1.0.0",
  "description": "Приложение для теста скорости печати",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "run-p dev:frontend dev:backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "openapigen": "run-p openapigen:frontend openapigen:backend",
    "openapigen:frontend": "npm run openapigen --workspace frontend",
    "openapigen:backend": "npm run openapigen --workspace backend",
    "docker": "docker compose up --build -d",
    "docker-down": "docker compose down",
    "docker-drop": "docker compose down -v",
    "start": "run-p dev docker"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
